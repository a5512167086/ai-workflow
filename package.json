{
  "name": "ai-workflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "用本機 Claude Code / Codex CLI 與共用 Skills 跑 PRD、內建任務管理、實作審查及人工驗收的桌面工作流工具",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc -b && vite build",
    "preview:web": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:ui && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "vitest run",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "icons": "tauri icon src-tauri/icons/icon.svg -o src-tauri/icons",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.552.0",
    "mermaid": "^12.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.17.0",
    "react-router-dom": "^7.9.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
