{
  "name": "aipipe",
  "private": true,
  "version": "0.3.0",
  "description": "用本機 Claude Code / Codex CLI 與共用 Skills 跑 PRD、內建任務管理、實作審查及人工驗收的桌面工作流工具",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "npm run test:ui && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "icons": "tauri icon src-tauri/icons/icon.svg -o src-tauri/icons",
    "tauri": "tauri",
    "test:ui": "node --test tests/ui.test.cjs",
    "prebuild": "node scripts/vendor-ui.cjs",
    "predev": "node scripts/vendor-ui.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "jsdom": "^30.1.3",
    "mermaid": "^12.2.0"
  }
}
