{
  "name": "aipipe",
  "private": true,
  "version": "0.1.1",
  "description": "用本機 Claude Code / Codex CLI 與共用 Skills 跑 PRD、內建任務管理、實作審查及人工驗收的桌面工作流工具",
  "type": "module",
  "bin": {
    "aipipe": "legacy/bin/aipipe.js"
  },
  "scripts": {
    "test": "node --test legacy/test/*.test.js",
    "sidecar": "node legacy/build-sidecar.mjs",
    "icons": "tauri icon legacy/web/icon.svg -o src-tauri/icons",
    "tauri": "tauri",
    "dev": "npm run sidecar && tauri dev",
    "build": "npm run sidecar && tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6"
  }
}
