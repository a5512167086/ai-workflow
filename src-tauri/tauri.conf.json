{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-workflow",
  "version": "0.1.0",
  "identifier": "dev.ai-workflow.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ai-workflow",
        "url": "index.html",
        "width": 1320,
        "height": 880,
        "minWidth": 400,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "AI 開發流程工具",
    "longDescription": "用本機已登入的 Claude Code / Codex CLI 跑 PRD → 交叉審查 → 拆任務 → 實作與審查 → 人工測試的流程。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
